# ── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECRET=your_super_secret_cookie_key_min_32_chars_here!!
COOKIE_DOMAIN=
CSRF_SECRET=your_super_secret_csrf_key_min_32_chars_here!!

# ── Database (MySQL) ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=hanifa_elektronik_db
DB_CONNECTION_LIMIT=10

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here!!
JWT_EXPIRES_IN=7d
JWT_ISSUER=hanifa-elektronik-backend
JWT_AUDIENCE=hanifa-elektronik-client

# ── Storage ─────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=public/uploads

# ── Email / SMTP ────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password
EMAIL_FROM_NAME=your_name

# ── Redis (Anti-DoS Throttler & Distributed Cache) ─────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Rate Limiting (Throttler) ───────────────────────────────
THROTTLE_TTL_DEFAULT=60000
THROTTLE_LIMIT_DEFAULT=100
THROTTLE_TTL_STRICT=60000
THROTTLE_LIMIT_STRICT=10
THROTTLE_TTL_DASHBOARD=60000
THROTTLE_LIMIT_DASHBOARD=500

# ── MongoDB (Audit Trail & Anti-Tamper System Logs) ──────────
MONGODB_URI=mongodb://localhost:27017/hanifa_elektronik_audit
AUDIT_LOG_ENABLED=true
